# ============================================================
# Configuration du Bot de Signaux Forex
# ============================================================

# --- Telegram ---
TELEGRAM_TOKEN=8639548180:AAELOEVuvyui4cSjbWfyGEyX6vxMY6E0Huc
TELEGRAM_CHAT_ID=@hadarforexsignal

# --- Source de donnees Forex ---
DATA_SOURCE=yfinance

# --- OANDA (optionnel, si DATA_SOURCE=oanda) ---
OANDA_API_KEY=VOTRE_CLE_OANDA_ICI
OANDA_ACCOUNT_ID=VOTRE_COMPTE_OANDA_ICI
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# --- Paires Forex reelles (separees par des virgules) ---
FOREX_PAIRS=EURUSD=X,GBPUSD=X,AUDJPY=X,USDJPY=X,GBPJPY=X,EURGBP=X,USDCHF=X,AUDUSD=X,NZDUSD=X,USDCAD=X

# --- Paires OTC (disponibles 24h/24 sur Olymp Trade) ---
# true = active, false = desactive
OTC_ENABLED=true
# Les paires OTC utilisent les donnees de la paire reelle sous-jacente
OTC_PAIRS=OTC_EURUSD,OTC_GBPUSD,OTC_USDJPY,OTC_AUDUSD,OTC_EURGBP,OTC_GBPJPY

# --- Parametres de la strategie ---
TIMEFRAME=5m
EMA_PERIOD=20
RSI_PERIOD=14
BB_PERIOD=20
BB_STD=2

# --- Parametres d'execution ---
SCAN_INTERVAL=300

# --- Fuseau horaire ---
# 1 = GMT+1 (Porto Novo, Cotonou, Lome, etc.)
TIMEZONE_OFFSET=1

# --- Moteur d'alerte ---
CANDLE_OFFSET_SECONDS=2

# --- Gestion des erreurs ---
MAX_CONSECUTIVE_ERRORS=10
BASE_RETRY_DELAY=30
MAX_RETRY_DELAY=300
NOTIFY_AFTER_ERRORS=3
